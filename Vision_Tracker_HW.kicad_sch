				(size 0.525 0.525)
			)
			(justify left top)
		)
		(uuid "cb6dac65-26b7-428d-8347-77276579d842")
	)
	(text "PAN_PWM    PA0  CN7-28"
		(exclude_from_sim no)
		(at 15.56 96.3 0)
		(effects
			(font
				(face "Malgun Gothic")
				(size 0.525 0.525)
			)
			(justify left top)
		)
		(uuid "ccadd986-4f5a-45cd-97d0-f1ba54563f0f")
	)
	(text "보드 내장 RESET 바이어스\n(등가 회로 표시)"
		(exclude_from_sim no)
		(at 71.84 49.26 0)
		(effects
			(font
				(face "Malgun Gothic")
				(size 0.441 0.441)
			)
			(justify left top)
